{
    "schema_version": "1.0",
    "id": "campaign_plan",
    "version": "0.2.1",
    "status": "draft",
    "description": "Build a Meta campaign plan and create non-live Meta Draft objects from offer, goal, budget, audience, destination, tracking, and business context.",
    "when_to_use": [
        "new campaign",
        "budget and structure plan",
        "audience and creative matrix",
        "launch readiness"
    ],
    "do_not_use": [
        "live launch",
        "unrequested campaign creation",
        "product release outside Meta ads"
    ],
    "advertiser_job": {
        "default": "plan_future_campaigns",
        "alternatives": [
            "create_and_launch_new_ads"
        ]
    },
    "required_inputs": [
        "offer",
        "business goal",
        "budget and duration",
        "geography",
        "audience or ICP",
        "destination",
        "tracking status"
    ],
    "optional_inputs": [
        "page id",
        "instagram account",
        "existing creative",
        "catalog id",
        "special ad category"
    ],
    "read_groups": [
        "R-ACCOUNT",
        "R-PLAN",
        "R-AUDIENCE",
        "R-CATALOG"
    ],
    "optional_read_groups": [
        "R-TRACK",
        "R-CREATIVE"
    ],
    "draft_groups": [
        "D-LAUNCH"
    ],
    "required_evidence": [
        "offer and destination",
        "account and page access",
        "audience details",
        "budget inputs",
        "tracking state",
        "catalog eligibility when relevant",
        "missing data"
    ],
    "output_contract": {
        "id": "campaign_plan_v1",
        "required_fields": [
            "plan",
            "assumptions",
            "missing_data",
            "draft_request"
        ],
        "decision_modes": []
    },
    "hard_rules": [
        "Do not invent targeting attributes or catalog products.",
        "Do not claim a Draft is live or published. Report the returned Draft object id and state.",
        "Create campaign, ad set, ad, and creative objects only through permitted create tools that return Draft Mode objects.",
        "Never call activation or publish tools. Update or delete only existing Drafts through ads_update_entity with draft_only=true and fresh Draft readback.",
        "Do not use a landing page audit result without a page-reading tool.",
        "Require plan-first output and the exact user reply `确认创建草稿` before calling any create tool."
    ],
