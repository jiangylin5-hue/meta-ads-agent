LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_REASONING_EFFORT=high
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=4096

# Optional OpenAI Responses provider.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT_SECONDS=180

# DeepSeek OpenAI-compatible Chat Completions provider.
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com

AGENT_MAX_STEPS=16
AGENT_TURN_TIMEOUT_SECONDS=600

# Meta Marketing API integration.
# Use a Meta System User token with expires_at=never
# (non-expiring; 永不过期). Store the token value only in .env.
# Required scopes: ads_read, ads_management, ads_mcp_management.
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0
META_AD_ACCOUNT_ID=
# Allow creation of PAUSED/Draft Meta objects. Activation and publishing stay blocked.
META_DRAFT_WRITE_ENABLED=true
META_LIVE_WRITE_ENABLED=false

# Official Meta Ads MCP endpoint.
ADS_MCP_ENDPOINT_URL=https://mcp.facebook.com/ads
# Use the same non-expiring System User token as META_ACCESS_TOKEN.
ADS_MCP_API_TOKEN=
ADS_MCP_AUTH_TOKEN=
ACCOUNT_GATEWAY_PREFERENCE=mcp

# PostgreSQL primary database. SQLite is supported only as a legacy import source.
DATABASE_URL=postgresql+psycopg://ads_agent:ads_agent@127.0.0.1:5432/ads_agent?connect_timeout=3
ADS_AGENT_SECRET_KEY=replace-me-with-a-local-development-secret
LEGACY_SQLITE_IMPORT_PATH=_runtime/ads_agent.sqlite3
APP_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3100
